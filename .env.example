# ---------------------------------------------------------------------------
# Configuration template for online-class-transcriber.
#
# Copy to `.env` and fill in the blanks:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed -- it holds live API keys.
# Anything already exported in your real shell wins over the values here, so
# `WHISPER_COMPUTE_TYPE=int8 python main.py` overrides this file without an
# edit. Both `summarizer.py` and `transcriber.py` call `load_dotenv()` on
# import, so this file is honoured even when a module is imported on its own.
# ---------------------------------------------------------------------------


# --- Secrets ----------------------------------------------------------------

# NVIDIA API key, used for both LLM stages (https://build.nvidia.com).
# Required. Without it Stage 3 fails at client construction.
NVIDIA_API_KEY=nvapi-your-key-here

# Hugging Face token, used to download the pyannote diarization weights.
# Required for speaker attribution in Stage 2. Create one at
# https://huggingface.co/settings/tokens, then accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# -- an unaccepted token fails at the download, not at the API call.
HF_TOKEN=hf_your-token-here


# --- Stage 3: Heavyweight Synthesis & Vision-Audio Speaker Fusion -----------

# The reasoning model that merges transcript + slide deck into study notes.
# This default matters more than it looks: Nemotron writes its chain of
# thought inline into `content`, which starves the 4096-token output budget
# and produced meta-commentary instead of notes. It is the reason
# REDUCE_REASONING_ENABLED below exists.
REDUCE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Set to 1 to let REDUCE_MODEL reason before writing. Off by default: this
# pipeline wants the document, not the deliberation. Only turn it on for a
# model whose reasoning does not land in `content`.
#   1 / true / yes / on  -> reasoning enabled
#   anything else        -> disabled
REDUCE_REASONING_ENABLED=0


# --- Stage 1: Fast Vision & OCR Extraction ----------------------------------

# Vision model that reads one slide image per call. Needs image input, so a
# text-only model silently returns descriptions of nothing.
MAP_MODEL=meta/llama-3.2-11b-vision-instruct

# Shared fallback for both stages above. Only consulted when MAP_MODEL or
# REDUCE_MODEL is unset.
LLM_MODEL_NAME=meta/llama-3.1-8b-instruct


# --- Stage 2: WhisperX throughput -------------------------------------------

# CTranslate2 quantization for the local Whisper model. Must match the device
# in transcriber.py, and the two do NOT have the same right answer:
#
#   int8      -- use on CPU (what DEVICE currently is). CTranslate2 has to
#                emulate half precision on CPU, so int8 is the FASTER path.
#   float16   -- use only once DEVICE is switched to "cuda". On a GPU this
#                roughly doubles throughput over float32.
#
# Getting this wrong is not a crash, it is a silent multi-hour transcription:
# a CPU host left on float16 can run several times slower than int8.
WHISPER_COMPUTE_TYPE=int8

# Audio chunks decoded in parallel. The single largest throughput lever after
# the compute type -- a 90-minute lecture is thousands of short windows, and
# faster_whisper processes them one at a time by default.
#   16   -- safe CPU default
#   32+  -- fine for `base` on a GPU
# Lower it if long-v3 on a long lecture exhausts RAM.
WHISPER_BATCH_SIZE=16
